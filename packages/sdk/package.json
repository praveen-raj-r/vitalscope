{
  "name": "@praveen-raj/vitalscope",
  "version": "0.1.0",
  "description": "Tiny real-user Core Web Vitals SDK (LCP, INP, CLS, FCP, TTFB) under 5 KB gzipped",
  "license": "MIT",
  "author": "Praveen Raj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praveen-raj-r/vitalscope.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/praveen-raj-r/vitalscope#readme",
  "bugs": {
    "url": "https://github.com/praveen-raj-r/vitalscope/issues"
  },
  "keywords": [
    "core-web-vitals",
    "web-vitals",
    "rum",
    "real-user-monitoring",
    "performance",
    "lcp",
    "inp",
    "cls"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vitalscope.global.js",
  "jsdelivr": "./dist/vitalscope.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run size"
  },
  "dependencies": {
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "eslint": "^9",
    "happy-dom": "^21.0.4",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
