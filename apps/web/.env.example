# Public (safe for the browser; RLS applies)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose. Used by /api/ingest and cron (week 3+).
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string that protects /api/cron/daily (e.g. `openssl rand -hex 32`). Vercel sends it as a Bearer token.
CRON_SECRET=

# The site the public /demo shows (the "Sample data" site id). The demo reads it with the service role, so only ever set this to synthetic data.
DEMO_SITE_ID=

# Sentry error reporting. With no DSN nothing is sent. The DSN is public (it only allows sending events).
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for readable stack traces: set these in the Vercel project (not locally) so the build can upload source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
